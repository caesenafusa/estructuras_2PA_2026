class nodo:
    def __init__(self, dato):
        self.dato = dato
        self.siguiente = None

class pila:

    def __init__(self):
        self.primero = None

    def empilar(self,dato):
        nuevo=nodo(dato)
        if self.primero==None:
            self.primero=nuevo
        else:
            actual=self.primero
            while actual.siguiente:
                actual=actual.siguiente
            actual.siguiente=nuevo

    def desempilar(self):
        if self.primero==None:
            print("Pila vacia")
            return
        else:
            actual=self.primero
            while actual.siguiente.siguiente:
                actual=actual.siguiente
            dato=actual.siguiente.dato
            actual.siguiente=None
            return dato
        

    def mostrar(self):
        actual=self.primero
        while actual:
            print(actual.dato)
            actual=actual.siguiente

